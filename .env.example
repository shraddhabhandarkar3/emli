# PostgreSQL
POSTGRES_USER=emli
POSTGRES_PASSWORD=emli
POSTGRES_DB=emli
POSTGRES_PORT=5432
DATABASE_URL=postgresql://emli:emli@localhost:5432/emli

# Gmail OAuth — download client credentials from Google Cloud Console
# Enable Gmail API, create an OAuth 2.0 Desktop client, save as client_secret.json
GOOGLE_CREDENTIALS_PATH=client_secret.json
GOOGLE_TOKEN_PATH=token/token.json        # written by `make auth`
GOOGLE_STATE_PATH=token/gmail_state.json  # tracks last-fetched historyId
GMAIL_FETCH_DAYS=2                     # how far back to go on first run

# Notion
NOTION_TOKEN=
NOTION_PAGE_ID=
# NOTION_DATABASE_ID is written automatically by `make setup-notion` — do not set manually
NOTION_DATABASE_ID=

# LLM classifier — "api" (default, external OpenAI-compatible) or "ollama" (local)
LLM_PROVIDER=api

# Ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434  # http://ollama:11434 inside Docker

# External API — works with Groq, NVIDIA NIM, OpenAI, OpenRouter, etc.
# Groq (free, fast):   https://console.groq.com
#   API_BASE_URL=https://api.groq.com/openai/v1
#   API_MODEL=llama-3.3-70b-versatile
#   LLM_TIMEOUT=30
#
# NVIDIA NIM (free, slow):  https://build.nvidia.com
#   API_BASE_URL=https://integrate.api.nvidia.com/v1
#   API_MODEL=meta/llama-3.1-8b-instruct
#   LLM_TIMEOUT=120
#
# OpenAI (paid):  https://platform.openai.com
#   API_BASE_URL=    # omit — SDK uses OpenAI default
#   API_MODEL=gpt-4o-mini
API_BASE_URL=https://api.groq.com/openai/v1
API_KEY=
API_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=60  # increase to 120 for NVIDIA NIM

# Rate limiting — pause after every LLM_BATCH_SIZE calls
# Set LLM_BATCH_SIZE=0 to skip pausing (Groq/OpenAI handle backpressure themselves)
LLM_BATCH_SIZE=20
LLM_PAUSE_SECONDS=60

# Timezone for applied_date conversion in Notion
TIMEZONE=America/Los_Angeles

# Scheduler interval (only relevant for `make scheduler`)
FETCH_INTERVAL_MINUTES=15
